# Server
NODE_ENV=development
PORT=5000

# Database — single connection URL for local or hosted database (e.g. Supabase, Render, Neon, RDS)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/carepoint_dev
DATABASE_URL_TEST=postgresql://postgres:yourpassword@localhost:5432/carepoint_test

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# CORS — URL of the Next.js frontend (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Bcrypt work factor
BCRYPT_ROUNDS=12
